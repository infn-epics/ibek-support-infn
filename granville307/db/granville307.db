# Macros: P (PV prefix), PORT (asyn port), ADDR (RS-485 address),
# PROTO (granville307-rs232.proto or granville307-rs485.proto),
# PRES_UNIT_DEFAULT (0 = Torr, 1 = Bar).
# RS-232 protocol ignores ADDR; RS-485 protocol uses it for addressed commands.

record(ai, "$(P):IG1:Pressure") {
    field(DESC, "Ion gauge 1 pressure")
    field(DTYP, "stream")
    field(INP, "@$(PROTO) readPressure(IG1,$(ADDR)) $(PORT)")
    field(SCAN, "10 second")
    field(EGU, "Torr")
    field(PREC, "3")
    field(HIHI, "1e8")
    field(HHSV, "INVALID")
}

record(calc, "$(P):IG1:Valid") {
    field(DESC, "IG1 pressure valid")
    field(INPA, "$(P):IG1:Pressure CP NMS")
    field(CALC, "A<1e8")
    field(PREC, "0")
}

record(ai, "$(P):IG2:Pressure") {
    field(DESC, "Ion gauge 2 pressure")
    field(DTYP, "stream")
    field(INP, "@$(PROTO) readPressure(IG2,$(ADDR)) $(PORT)")
    field(SCAN, "10 second")
    field(EGU, "Torr")
    field(PREC, "3")
    field(HIHI, "1e8")
    field(HHSV, "INVALID")
}

record(calc, "$(P):IG2:Valid") {
