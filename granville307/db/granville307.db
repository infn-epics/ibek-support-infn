record(bo, "$(P):IG1:Enable") {
    field(DESC, "Request ion gauge 1 off/on")
    field(DTYP, "stream")
    field(OUT, "@$(PROTO) enableIG1($(ADDR)) $(PORT)")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
}

record(bo, "$(P):IG2:Enable") {
    field(DESC, "Request ion gauge 2 off/on")
    field(DTYP, "stream")
    field(OUT, "@$(PROTO) enableIG2($(ADDR)) $(PORT)")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
}

