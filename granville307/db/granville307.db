# STATE_RB follows the UniVac vacuum-channel convention: 1 means a valid
# pressure reply, 0 means the DS reply is at/above the controller sentinel.
# The manual describes the sentinel for an off or starting ion gauge and for
# an absent auxiliary gauge module; this is a measurement state, not link health.
record(calc, "$(P):IG1:STATE_RB") {
    field(DESC, "IG1 state (1=valid)")
    field(INPA, "$(P):IG1:Pressure CP")
    field(CALC, "A<1e8")
    field(PREC, "0")
}

record(calc, "$(P):IG2:STATE_RB") {
    field(DESC, "IG2 state (1=valid)")
    field(INPA, "$(P):IG2:Pressure CP")
    field(CALC, "A<1e8")
    field(PREC, "0")
}

record(calc, "$(P):IG:STATE_RB") {
    field(DESC, "Active IG state (1=valid)")
    field(INPA, "$(P):IG:Pressure CP")
    field(CALC, "A<1e8")
    field(PREC, "0")
}

record(calc, "$(P):CG1:STATE_RB") {
    field(DESC, "CG1 state (1=valid)")
    field(INPA, "$(P):CG1:Pressure CP")
    field(CALC, "A<1e8")
    field(PREC, "0")
}

record(calc, "$(P):CG2:STATE_RB") {
    field(DESC, "CG2 state (1=valid)")
    field(INPA, "$(P):CG2:Pressure CP")
    field(CALC, "A<1e8")
    field(PREC, "0")
}

# Select the output unit at runtime. The 307 must report pressure in Torr.
record(mbbo, "$(P):UNIT_RB") {
    field(DESC, "Pressure units Torr/Bar")
    field(DTYP, "Soft Channel")
    field(ZRST, "Torr")
    field(ONST, "Bar")
    field(ZRVL, "0")
    field(ONVL, "1")
    field(VAL, "$(PRES_UNIT_DEFAULT)")
    field(PINI, "YES")
    field(OUT, "$(P):UNIT_CODE")
}

record(longin, "$(P):UNIT_CODE") {
    field(DESC, "Pressure unit selector")
    field(SCAN, "Passive")
}

# UniVac-compatible pressure readbacks. The selected unit is 0 = Torr and
# 1 = Bar; the calculation converts the Torr source when Bar is selected.
record(calc, "$(P):IG1:PRES_RB") {
    field(DESC, "IG1 pressure readback")
    field(INPA, "$(P):IG1:Pressure CP")
    field(INPB, "$(P):UNIT_RB CP")
    field(CALC, "A*(1-B*0.998666776316)")
    field(PREC, "4")
    field(HIHI, "1e8")
    field(HHSV, "INVALID")
}

record(calc, "$(P):IG2:PRES_RB") {
    field(DESC, "IG2 pressure readback")
    field(INPA, "$(P):IG2:Pressure CP")
    field(INPB, "$(P):UNIT_RB CP")
    field(CALC, "A*(1-B*0.998666776316)")
    field(PREC, "4")
    field(HIHI, "1e8")
    field(HHSV, "INVALID")
}

record(calc, "$(P):IG:PRES_RB") {
    field(DESC, "Active IG pressure readback")
    field(INPA, "$(P):IG:Pressure CP")
    field(INPB, "$(P):UNIT_RB CP")
