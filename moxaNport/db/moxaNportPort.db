# Moxa NPort web-console IOC. Generated layout; edit freely.
# Per serial port records. Macros: P, PORT, N (port number 1..), ADDR (= N-1)

# ---- Serial Settings (03View.htm)
record(stringin, "$(P):P$(N):SER:ALIAS") {
    field(DESC, "Port alias")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)SER_ALIAS")
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):P$(N):SER:BAUD") {
    field(DESC, "Baud rate")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)SER_BAUD")
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):P$(N):SER:DATABITS") {
    field(DESC, "Data bits")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)SER_DATABITS")
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):P$(N):SER:STOPBITS") {
    field(DESC, "Stop bits")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)SER_STOPBITS")
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):P$(N):SER:PARITY") {
    field(DESC, "Parity")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)SER_PARITY")
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):P$(N):SER:FIFO") {
    field(DESC, "UART FIFO")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)SER_FIFO")
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):P$(N):SER:FLOW") {
    field(DESC, "Flow control")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)SER_FLOW")
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):P$(N):SER:IFACE") {
    field(DESC, "Interface")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)SER_IFACE")
    field(SCAN, "I/O Intr")
}

# ---- Operating Settings (04View.htm)
record(stringin, "$(P):P$(N):OP:MODE") {
    field(DESC, "Operating mode (text)")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)OP_MODE")
    field(SCAN, "I/O Intr")
}
record(mbbi, "$(P):P$(N):OP:MODE_RBV") {
    field(DESC, "Operating mode")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR),1)OP_MODE_IDX")
    field(SCAN, "I/O Intr")
    field(ZRVL, "0")
    field(ZRST, "Real COM")
    field(ONVL, "1")
    field(ONST, "TCP Server")
    field(TWVL, "2")
    field(TWST, "TCP Client")
    field(THVL, "3")
    field(THST, "UDP")
    field(FRVL, "4")
    field(FRST, "Pair Slave")
    field(FVVL, "5")
    field(FVST, "Pair Master")
    field(SXVL, "6")
    field(SXST, "Reverse Telnet")
    field(SVVL, "7")
    field(SVST, "Disabled")
    field(EIVL, "8")
    field(EIST, "RFC2217")
    field(NIVL, "9")
    field(NIST, "Ethernet Modem")
    field(TEVL, "10")
    field(TEST, "Printer")
    field(UNSV, "MINOR")
}
record(mbbo, "$(P):P$(N):OP:MODE_SP") {
    field(DESC, "Set operating mode (needs restart)")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),1)OP_MODE_SP")
    field(ZRVL, "0")
    field(ZRST, "Real COM")
    field(ONVL, "1")
    field(ONST, "TCP Server")
    field(TWVL, "2")
    field(TWST, "TCP Client")
    field(THVL, "3")
    field(THST, "UDP")
    field(FRVL, "4")
    field(FRST, "Pair Slave")
    field(FVVL, "5")
    field(FVST, "Pair Master")
    field(SXVL, "6")
    field(SXST, "Reverse Telnet")
    field(SVVL, "7")
    field(SVST, "Disabled")
    field(EIVL, "8")
    field(EIST, "RFC2217")
    field(NIVL, "9")
    field(NIST, "Ethernet Modem")
    field(TEVL, "10")
    field(TEST, "Printer")
}
record(stringin, "$(P):P$(N):OP:PACKLEN") {
    field(DESC, "Packing length")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)OP_PACKLEN")
    field(SCAN, "I/O Intr")
}
