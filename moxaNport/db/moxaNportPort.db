# ---- Monitor Async (Mn_asyn.htm)
record(ai, "$(P):P$(N):ASY:TXCNT") {
    field(DESC, "Tx bytes since port open")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(ADDR),1)ASY_TXCNT")
    field(EGU,  "B")
    field(PREC, "0")
    field(SCAN, "I/O Intr")
}
record(ai, "$(P):P$(N):ASY:RXCNT") {
    field(DESC, "Rx bytes since port open")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(ADDR),1)ASY_RXCNT")
    field(EGU,  "B")
    field(PREC, "0")
    field(SCAN, "I/O Intr")
}
record(ai, "$(P):P$(N):ASY:TXTOT") {
    field(DESC, "Tx bytes since boot")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(ADDR),1)ASY_TXTOT")
    field(EGU,  "B")
    field(PREC, "0")
    field(SCAN, "I/O Intr")
}
record(ai, "$(P):P$(N):ASY:RXTOT") {
    field(DESC, "Rx bytes since boot")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(ADDR),1)ASY_RXTOT")
    field(EGU,  "B")
    field(PREC, "0")
    field(SCAN, "I/O Intr")
}
record(ai, "$(P):P$(N):ASY:TXRATE") {
    field(DESC, "Tx rate")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(ADDR),1)ASY_TXRATE")
    field(EGU,  "B/s")
    field(PREC, "1")
    field(SCAN, "I/O Intr")
}
record(ai, "$(P):P$(N):ASY:RXRATE") {
    field(DESC, "Rx rate")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(ADDR),1)ASY_RXRATE")
    field(EGU,  "B/s")
    field(PREC, "1")
    field(SCAN, "I/O Intr")
}
record(mbbi, "$(P):P$(N):ASY:DSR") {
    field(DESC, "DSR line state")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR),1)ASY_DSR")
    field(SCAN, "I/O Intr")
