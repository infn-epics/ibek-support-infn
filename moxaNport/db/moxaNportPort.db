}
record(stringin, "$(P):P$(N):OP:DELIM2") {
    field(DESC, "Delimiter 2")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)OP_DELIM2")
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):P$(N):OP:DELIMPROC") {
    field(DESC, "Delimiter process")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)OP_DELIMPROC")
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):P$(N):OP:FORCETX") {
    field(DESC, "Force transmit [ms]")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)OP_FORCETX")
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):P$(N):OP:ALIVE") {
    field(DESC, "TCP alive check [min]")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)OP_ALIVE")
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):P$(N):OP:INACT") {
    field(DESC, "Inactivity time [ms]")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)OP_INACT")
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):P$(N):OP:MAXCONN") {
    field(DESC, "Max connections")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)OP_MAXCONN")
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):P$(N):OP:LOCALPORT") {
    field(DESC, "Local TCP port")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)OP_LOCALPORT")
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):P$(N):OP:CMDPORT") {
    field(DESC, "Command port")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)OP_CMDPORT")
    field(SCAN, "I/O Intr")
}
record(waveform, "$(P):P$(N):OP:DETAILS") {
    field(DESC, "All operating settings")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR),1)OP_DETAILS")
    field(FTVL, "CHAR")
    field(NELM, "512")
    field(SCAN, "I/O Intr")
}

